<?xml version="1.0" encoding="UTF-8"?>
<!-- 
     =====================================================================
     activity_intro.xml - Custom Black & Centered Layout
     =====================================================================
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:visibility="gone">

    <!-- 📜 Tam ortalanmış içerik alanı -->
    <ScrollView
        android:id="@+id/scrollable_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_layout"
        android:layout_alignParentTop="true"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 🏷️ Ortalanmış Logo -->
            <ImageView
                android:id="@+id/logo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginBottom="24dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/app_logo_onboarding" />

            <!-- 📝 Ortalanmış Başlık Metni -->
            <TextView
                android:id="@+id/item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:letterSpacing=".05"
                android:text="@string/splash_app_name"
                android:textAppearance="@style/TextAppearance.AppCompat.Display1"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <!-- ✏️ Ortalanmış Alt Başlık Metni -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing=".05"
                android:text="@string/splash_app_subtitle"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="#CCCCCC" />
        </LinearLayout>
    </ScrollView>

    <!-- ⚓ Alt Buton ve Çizgiler Alanı -->
    <LinearLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="50dp">

        <!-- ➖ Sol Çizgi -->
        <View
            android:id="@+id/left_line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#333333" />

        <!-- 🟢 Başla Butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/get_started_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/white"
            android:letterSpacing=".1"
            android:text="@string/get_started_text"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <!-- ➖ Sağ Çizgi -->
        <View
            android:id="@+id/right_line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#333333" />
    </LinearLayout>

</RelativeLayout>
